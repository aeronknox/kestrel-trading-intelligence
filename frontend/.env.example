# Server-side: where the Next.js API proxy forwards /api/v1/* requests
BACKEND_INTERNAL_URL=http://localhost:8000
# Browser-side: live market WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/market
# Must match the backend PROXY_SHARED_SECRET
PROXY_SHARED_SECRET=
# Set to true only when a trusted reverse proxy in front of Next.js sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
