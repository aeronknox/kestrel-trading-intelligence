# ---------------------------------------------------------------------------
# AI Trading Intelligence Platform — environment configuration
# Copy to `.env` (repo root, used by docker compose) and/or `backend/.env`.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production for structured JSON logs

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72
COOKIE_SECURE=false                # true when served over HTTPS
CORS_ORIGINS=http://localhost:3000
# Comma-separated emails that are granted the admin role on registration
ADMIN_EMAILS=                      # granted admin once the address is verified by email

# --- Email (verification + password reset) ---
# console = print emails and their links to the backend log (development).
# smtp    = deliver through any SMTP relay (Resend, SES, Postmark, Mailgun, Gmail...).
EMAIL_BACKEND=console
EMAIL_FROM=Kestrel Intelligence <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls             # starttls | ssl | none
PUBLIC_APP_URL=http://localhost:3000   # base URL used in emailed links
# Client-IP trust for rate limiting/audit. Only needed when a reverse proxy sits in front
# of Next.js and sets X-Forwarded-For: then set TRUST_PROXY_HEADERS=true and a random
# PROXY_SHARED_SECRET (openssl rand -hex 32). docker-compose.prod.yml (Caddy) sets
# TRUST_PROXY_HEADERS itself and requires PROXY_SHARED_SECRET.
# Otherwise the API rate-limits by the connecting peer and ignores X-Forwarded-For.
TRUST_PROXY_HEADERS=false
PROXY_SHARED_SECRET=
# X-Forwarded-For is also trusted from these peers (CIDRs)
TRUSTED_PROXIES=127.0.0.1/32,::1/128
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# --- Database / cache ------------------------------------------------------
# Local dev without Docker can use SQLite: sqlite+aiosqlite:///./data/dev.db
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading
# Leave empty to use the in-process cache / rate limiter
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=15
COMPUTE_RATE_LIMIT_PER_MINUTE=30

# --- Market data -----------------------------------------------------------
# coinbase = Coinbase Exchange public market data (real data, no key needed)
# sample   = synthetic, clearly-labelled SAMPLE data for offline development
MARKET_DATA_PROVIDER=coinbase
MARKET_WS_POLL_SECONDS=5
# Gradually download up to 20,000 bars of 1h/6h/1d history per tracked asset for long backtests.
HISTORY_BACKFILL_ENABLED=true
HISTORY_BACKFILL_BARS_PER_MINUTE=3000   # about 10 provider requests per minute

# --- AI --------------------------------------------------------------------
# Optional. Without a key, analysis narratives and the assistant fall back to
# deterministic, data-driven summaries (clearly labelled as such).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# --- Paper trading ---------------------------------------------------------
PAPER_STARTING_BALANCE=100000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5

# --- Frontend --------------------------------------------------------------
# URL the Next.js server uses to reach the API (server-side proxy target)
BACKEND_INTERNAL_URL=http://localhost:8000
# Browser-facing WebSocket URL for live market updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/market
